{
  "name": "ua-arena",
  "private": true,
  "type": "module",
  "devDependencies": {
    "esbuild": "0.25.11"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "server": "node server/index.mjs",
    "worker:build": "node scripts/build-worker.mjs",
    "worker:dev": "node scripts/build-worker.mjs && npx --yes wrangler dev",
    "worker:deploy": "node scripts/build-worker.mjs && npx --yes wrangler deploy",
    "benchmark:ai": "node scripts/benchmark-ai.mjs"
  }
}
